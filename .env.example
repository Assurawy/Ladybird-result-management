# Neon (or any Postgres) connection strings.
# DATABASE_URL: pooled connection (used at runtime, via PgBouncer/Neon pooler)
# DIRECT_URL: direct connection (used by `prisma migrate`)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Long random string used to sign session JWTs — generate with:
#   openssl rand -base64 48
AUTH_SECRET=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: object storage for photos/logos/signatures (Vercel Blob shown as
# the default choice since this deploys to Vercel; swap for S3/Cloudinary if
# you prefer — see lib/media.ts)
BLOB_READ_WRITE_TOKEN=""
